# Настройки приложения
APP_TIMEZONE=Europe/Amsterdam
OWNER_NAME=Преподаватель
DEMO_DATA=false
AUTH_BYPASS=false

# Будущие интеграции
AI_API_KEY=
AI_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
