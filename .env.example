# Секреты — задаются только на сервере/в Amvera
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string
DB_PASSWORD=change-me

# PostgreSQL внутри Amvera
DB_HOST=amvera-user-cnpg-project-rw
DB_PORT=5432
DB_NAME=lessonworkshop
DB_USER=lessonapp
DB_SSLMODE=disable
# DATABASE_URL можно использовать вместо DB_* при необходимости
DATABASE_URL=

# Настройки приложения
APP_TIMEZONE=Europe/Amsterdam
OWNER_NAME=Светлана
DEMO_DATA=false
AUTH_BYPASS=false

# Будущие интеграции
AI_API_KEY=
AI_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
